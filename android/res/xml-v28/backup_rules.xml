<?xml version="1.0" encoding="utf-8"?>
<!-- Android 9 to 11. Only the app's saved state and settings, never the AI coach key, and only when
     the backup is encrypted with the screen lock (requireFlags, which Android 8 doesn't have: its
     rules in res/xml/ back up nothing). Notifications' schedule (notify.xml) is for this phone only.
     Android 12 and newer use data_extraction_rules.xml. -->
<full-backup-content>
    <include domain="file" path="." requireFlags="clientSideEncryption" />
    <include domain="sharedpref" path="." requireFlags="clientSideEncryption" />
    <exclude domain="sharedpref" path="secrets.xml" />
    <exclude domain="sharedpref" path="notify.xml" />
</full-backup-content>
