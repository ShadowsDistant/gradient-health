<?xml version="1.0" encoding="utf-8"?>
<!-- The app's "bolt" glyph (24x24 grid: M13 3.5 5.5 13.5H12l-1 7 7.5-10H12z), stroked in white.
     Its bounding box (5.5..18.5 x 3.5..20.5) is centred on (12,12); scaled 2.2x and moved so that
     point lands on (54,54), the centre of the 108dp canvas. The result is ~34x43dp including the
     stroke, well inside the 66dp safe zone. strokeWidth is in glyph units (2.25 * 2.2 = ~5dp). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.2"
        android:scaleY="2.2"
        android:translateX="27.6"
        android:translateY="27.6">
        <path
            android:pathData="M13,3.5 L5.5,13.5 L12,13.5 L11,20.5 L18.5,10.5 L12,10.5 Z"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.25"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
