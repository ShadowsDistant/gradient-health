<?xml version="1.0" encoding="utf-8"?>
<!-- Gradient Health: a WebView shell around the single-file web app (assets/index.html) plus a
     Health Connect bridge. Built without Gradle by scripts/build-apk.sh, which also passes
     the SDK levels and versionCode/versionName to aapt. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.shadowsdistant.gradienthealth">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="36" />

    <!-- Only for optional features: the Claude coach (api.anthropic.com), the on-device model
         download (huggingface.co) and online food search (openfoodfacts.org). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets a model download wait for Wi-Fi instead of using mobile data (a normal permission). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Health Connect. The platform API needs Android 14 (API 34) or newer. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <!-- 1.2: heart rate (an estimated resting heart rate when a watch app doesn't share one),
         active calories and distance, and food logged in other apps (all optional). -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_NUTRITION" />
    <!-- Optional: saves the app's own workouts to Health Connect so other apps see them. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <!-- Meals logged in the app, saved to Health Connect if the person allows it. -->
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" />
    <!-- 1.4, outdoor activities (all optional): total calories for an activity's summary, and saving
         a recorded run, walk, hike or ride with its route, plus its distance and active calories
         when no watch recorded them. -->
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE_ROUTE" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" />
    <!-- 1.4, background sync: reading Health Connect every 15 minutes with the app closed (a
         platform permission from Android 15; asked for only where Health Connect knows it). -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <!-- Keeps the background sync's job scheduled after the phone restarts (JobInfo.setPersisted). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Only for scanning food barcodes, and only when the person taps Scan. Not required, so
         phones without a camera can still install the app. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- Outdoor activities: the route (precise location, only while an activity the person started
         is recording, in a foreground service; no background location), steps from the phone's
         step counter, and the ongoing notification with time and distance. None is required. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />

    <!-- "Ask in the Claude app" hands a prompt to the Claude app when it's installed. -->
    <queries>
        <package android:name="com.anthropic.claude" />
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Apps that use Health Connect, so an activity's summary can name the app or watch that
             recorded its heart rate and steps (they all declare one of these). -->
        <intent>
            <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
            <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
        </intent>
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <!-- Backups: none on Android 8 (res/xml/backup_rules.xml), only end-to-end encrypted ones on 9-11
         (res/xml-v28/) and 12+ (data_extraction_rules.xml), never the API key. Every connection the
         app makes is HTTPS: plain http is refused. -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Gradient Health"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        android:theme="@style/AppTheme">

        <!-- No usage or crash metrics from the WebView to Google: the app has no analytics. -->
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Shared plans: gradienthealth://plan?d=… and, unverified (the browser keeps them
                 unless the person picks the app), https://shadowsdistant.github.io/gradient-health/p/….
                 The page gets them through __gh.onLink and AndroidBridge.pendingLink(). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gradienthealth" android:host="plan" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="shadowsdistant.github.io" />
                <!-- /gradient-health/p and what's under it, not other pages starting with "p". -->
                <data android:path="/gradient-health/p" />
                <data android:pathPrefix="/gradient-health/p/" />
            </intent-filter>
        </activity>

        <!-- The on-device coach's native engine runs in its own process, so a crash or an
             out-of-memory kill there can't take the app with it. Only the app can bind it. -->
        <service
            android:name=".LlmService"
            android:process=":llm"
            android:exported="false" />

        <!-- Background sync: JobScheduler runs it every 15 minutes. Only the system can bind it. -->
        <service
            android:name=".HealthSyncJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />

        <!-- Records an outdoor activity the person started in the app (GPS and steps), with an
             ongoing notification. Started only while the app is in front. -->
        <service
            android:name=".ActivityService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- A badge's picture, shared only to the app picked on the share sheet: read-only files in
             the cache's shared/ folder, opened through that share's one-time read grant. Not
             exported, so no other app can ask it for anything. -->
        <provider
            android:name=".ShareProvider"
            android:authorities="com.shadowsdistant.gradienthealth.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Health Connect privacy rationale (required on Android 14+ before the permission
             dialog is shown). Opens the app's privacy page (#privacy). -->
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
